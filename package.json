{
  "name": "dsh-ai-credit-hub",
  "version": "1.0.0",
  "description": "Draggable panel that gathers the remaining credit balance of every connected AI tool (Doubao, Qwen Work, WorkBuddy, Trae, Qoder) into one strip, expandable to a per-package breakdown.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek",
    "harness",
    "dsh",
    "credits",
    "balance",
    "quota"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/REPLACE_WITH_YOUR_GITHUB_USER/dsh-ai-credit-hub.git"
  },
  "homepage": "https://github.com/REPLACE_WITH_YOUR_GITHUB_USER/dsh-ai-credit-hub",
  "bugs": {
    "url": "https://github.com/REPLACE_WITH_YOUR_GITHUB_USER/dsh-ai-credit-hub/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "PUBLISH.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}